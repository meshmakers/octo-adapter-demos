<Project>
    <PropertyGroup>
        <OctoRootDirectoryPropsFilePath>$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))</OctoRootDirectoryPropsFilePath>
        <OctoUserPropsFilePath>$([MSBuild]::GetPathOfFileAbove('Octo.User.props', '$(MSBuildThisFileDirectory)'))</OctoUserPropsFilePath>
        <OctoRepoRootPath>$(MSBuildThisFileDirectory)</OctoRepoRootPath>
        <OctoRepoRootPath Condition="'$(OctoRootDirectoryPropsFilePath)'!=''">$([System.IO.Path]::GetDirectoryName($(OctoRootDirectoryPropsFilePath)))</OctoRepoRootPath>
    </PropertyGroup>
    <!-- Import an custom file to overwrite versions etc. -->
    <Import Condition="'$(OctoRootDirectoryPropsFilePath)'=='' And Exists($(OctoUserPropsFilePath))" Project="$(OctoUserPropsFilePath)"/>
    <!-- Import the Directory.Build.props file of the root directory -->
    <Import Condition="Exists($(OctoRootDirectoryPropsFilePath))" Project="$(OctoRootDirectoryPropsFilePath)"/>
    <PropertyGroup>
        <LangVersion>latestmajor</LangVersion>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <ImplicitUsings>true</ImplicitUsings>
        <RepositoryUrl>https://github.com/meshmakers/octo-adapter-demos</RepositoryUrl>
        <PackageIcon>meshmakers64.png</PackageIcon>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageProjectUrl>https://www.meshmakers.io</PackageProjectUrl>
        <PackageTags>Octo data mesh iot</PackageTags>
        <TargetFramework>net10.0</TargetFramework>
        <UserSecretsId>04bcde24-0d21-4346-8459-3bca58abec33</UserSecretsId>
        <!-- OctoVersion is the version range of the upstream Octo packages. It comes ONLY from
             the pipeline (AB#6291, AB#6297): update-build-number.yml sets 0.1.* on main, X.Y.* on
             test/X.Y-* and the exact X.Y.Z on r-tags; the release trains and hotfix-service.yml
             also pass octoCoreLibVersion / octoCommVersion. DebugL pins 999.0.0 (local chain from
             ../nuget), and a build against the private feed defaults to the main line 0.1.*.
             There is deliberately NO release-line fallback here: a build without any of these
             fails fast in the OctoVerifyVersionIsSet target below, and the release trains fail if
             a release version is pinned here again (verify-release-version-drift.ps1). -->
        <OctoVersion Condition="'$(Configuration)'=='DebugL'">999.0.0</OctoVersion>
        <OctoVersion Condition="'$(OctoNugetPrivateServer)'!='' And '$(OctoVersion)'==''">0.1.*</OctoVersion>
        <OctoCoreLibVersion Condition="'$(Configuration)'=='DebugL'">999.0.0</OctoCoreLibVersion>
        <OctoCoreLibVersion Condition="'$(OctoNugetPrivateServer)'!='' And '$(OctoCoreLibVersion)'==''">0.1.*</OctoCoreLibVersion>
        <!-- No pipeline override (standalone build): follow OctoVersion; no release version is pinned here (AB#6297). -->
        <OctoCoreLibVersion Condition="'$(OctoCoreLibVersion)'==''">$(OctoVersion)</OctoCoreLibVersion>
        <OctoCommVersion Condition="'$(Configuration)'=='DebugL'">999.0.0</OctoCommVersion>
        <OctoCommVersion Condition="'$(OctoNugetPrivateServer)'!='' And '$(OctoCommVersion)'==''">0.1.*</OctoCommVersion>
        <OctoCommVersion Condition="'$(OctoCommVersion)'==''">$(OctoVersion)</OctoCommVersion>
        <Version Condition="'$(Configuration)'=='DebugL'">999.0.0</Version>
        <RestoreSources Condition="'$(OctoNugetPrivateServer)'!=''">$(OctoNugetPrivateServer)</RestoreSources>
        <RestoreSources Condition="'$(Configuration)'=='DebugL'">$(RestoreSources);$(OctoRepoRootPath)../nuget</RestoreSources>
    </PropertyGroup>

    <!-- TIME-BOXED exception, expires 2026-11-08 (UTC). Mirrors octo-mesh-adapter/Directory.Build.props
         (AB#5946), which holds the full rationale and the exit criteria; keep both in step.
         SixLabors.ImageSharp 3.1.12 arrives transitively via
         Meshmakers.Octo.Sdk.MeshAdapter -> IronOcr -> IronSoftware.System.Drawing.
         The only patched version is 4.1.2 and it is not a drop-in. This adapter does not call ImageSharp. -->
    <ItemGroup Condition="$([System.DateTime]::UtcNow.ToString('yyyyMMdd')) &lt; 20261108">
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
    </ItemGroup>
    <!-- Fail fast (AB#6291, AB#6297): without a pipeline version, DebugL or a private feed
         OctoVersion stays empty, and every upstream Octo PackageReference would end in a cryptic
         NU1015 / NU1102 restore error. Hooked into the restore graph walk
         (_IsProjectRestoreSupported, CollectPackageReferences) and into the build
         (_CheckForInvalidConfigurationAndPlatform), so both `dotnet restore` and `dotnet build`
         stop before any package is resolved. -->
    <Target Name="OctoVerifyVersionIsSet"
            BeforeTargets="_IsProjectRestoreSupported;CollectPackageReferences;_CheckForInvalidConfigurationAndPlatform"
            Condition="'$(OctoVersion)'==''">
        <Error Code="OCTO0001"
               Text="OctoVersion is not set for configuration '$(Configuration)'. Octo lib versions come only from the pipeline (AB#6291); there is no hard-coded release fallback in Directory.Build.props. For local work build with -c DebugL (999.0.0 from ../nuget). For a standalone build pass -p:OctoVersion=X.Y.Z (or X.Y.*), or -p:OctoNugetPrivateServer=&lt;feed&gt; for the main line 0.1.*." />
    </Target>
</Project>
